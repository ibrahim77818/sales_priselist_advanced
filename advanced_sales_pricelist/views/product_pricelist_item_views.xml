<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Advanced mode: rule form -->
    <record id="product_pricelist_item_form_view_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.asp</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_rule_target']/field[@name='product_id']" position="after">
                <field name="asp_target" invisible="1"/>
                <field name="asp_allowed_uom_ids" invisible="1"/>
                <field name="asp_allowed_packaging_ids" invisible="1"/>
                <field name="uom_id"
                       groups="uom.group_uom"
                       options="{'no_create': True}"
                       domain="[('id', 'in', asp_allowed_uom_ids)]"
                       attrs="{'readonly': [('asp_target', '=', '0_packaging')]}"/>
                <field name="packaging_id"
                       groups="product.group_stock_packaging"
                       options="{'no_create': True}"
                       domain="[('id', 'in', asp_allowed_packaging_ids)]"
                       attrs="{'invisible': [('applied_on', 'not in', ('1_product', '0_product_variant'))],
                               'readonly': [('asp_target', '=', '1_uom')]}"/>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_base']//field[@name='price_surcharge']" position="after">
                <label for="price_surcharge_percent" string="Extra Fee (%)"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <div class="o_row" attrs="{'invisible': [('compute_price', '!=', 'formula')]}">
                    <field name="price_surcharge_percent" class="oe_inline"/>
                    <span>% on the</span>
                    <field name="price_surcharge_percent_base" class="oe_inline"
                           attrs="{'readonly': [('price_surcharge_percent', '=', 0)]}"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_computation']" position="after">
                <div class="alert alert-warning mb-3" role="status"
                     attrs="{'invisible': [('asp_target', '!=', '0_packaging')]}">
                    This rule applies only to order lines using this packaging. Fixed price, extra fee and margins are expressed per package and the minimum quantity is a number of packages.
                </div>
                <div class="alert alert-warning mb-3" role="status"
                     attrs="{'invisible': [('asp_target', '!=', '1_uom')]}">
                    This rule applies only when the product is sold in this unit of measure. Fixed price, extra fee, margins and minimum quantity are expressed in that unit.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Rule list (menu "Pricelist Rules" in debug / reporting) -->
    <record id="product_pricelist_item_tree_view_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree.asp</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
        <field name="arch" type="xml">
            <field name="min_quantity" position="after">
                <field name="uom_id" groups="uom.group_uom" optional="show"/>
                <field name="packaging_id" groups="product.group_stock_packaging" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Rules edited from a product / variant (smart button "Extra Prices") -->
    <record id="product_pricelist_item_tree_view_from_product_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree.from.product.asp</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view_from_product"/>
        <field name="arch" type="xml">
            <field name="min_quantity" position="before">
                <field name="asp_target" invisible="1"/>
                <field name="asp_allowed_uom_ids" invisible="1"/>
                <field name="asp_allowed_packaging_ids" invisible="1"/>
                <field name="uom_id"
                       groups="uom.group_uom"
                       optional="show"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', asp_allowed_uom_ids)]"
                       attrs="{'readonly': [('asp_target', '=', '0_packaging')]}"/>
                <field name="packaging_id"
                       groups="product.group_stock_packaging"
                       optional="show"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', asp_allowed_packaging_ids)]"
                       attrs="{'readonly': ['|', ('asp_target', '=', '1_uom'), ('applied_on', 'not in', ('1_product', '0_product_variant'))]}"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_item_view_search_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.item.search.asp</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="asp_filter_uom" string="Unit of Measure Rules"
                        domain="[('asp_target', '=', '1_uom')]" groups="uom.group_uom"/>
                <filter name="asp_filter_packaging" string="Packaging Rules"
                        domain="[('asp_target', '=', '0_packaging')]" groups="product.group_stock_packaging"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="packaging_id" groups="product.group_stock_packaging"/>
                <group expand="0" string="Group By">
                    <filter name="asp_groupby_target" string="Sold As" context="{'group_by': 'asp_target'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
