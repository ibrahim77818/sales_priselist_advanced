<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Bulk view of all pricelist rules: review, mass-edit, export and import.
        Editable grid usable in both pricelist modes; formula columns are only
        available in "Advanced price rules" mode (optional, hidden by default).
    -->
    <record id="asp_pricelist_item_tree_view_bulk" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree.asp.bulk</field>
        <field name="model">product.pricelist.item</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree string="Pricelist Rules" editable="bottom" multi_edit="1">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="asp_target" invisible="1"/>
                <field name="asp_allowed_uom_ids" invisible="1"/>
                <field name="asp_allowed_packaging_ids" invisible="1"/>
                <!-- ungrouped copies used by attrs in "Multiple prices per product" mode -->
                <field name="applied_on" invisible="1"/>
                <field name="compute_price" invisible="1"/>
                <field name="pricelist_id" options="{'no_create': True}"/>
                <field name="applied_on" groups="product.group_sale_pricelist"/>
                <field name="categ_id" groups="product.group_sale_pricelist" optional="show"
                       options="{'no_create': True}"
                       attrs="{'required': [('applied_on', '=', '2_product_category')],
                               'readonly': [('applied_on', '!=', '2_product_category')]}"/>
                <field name="product_tmpl_id" options="{'no_create': True}"
                       attrs="{'required': [('applied_on', '=', '1_product')]}"/>
                <field name="product_id" groups="product.group_product_variant" optional="show"
                       options="{'no_create': True}"
                       domain="[('product_tmpl_id', '=?', product_tmpl_id)]"
                       attrs="{'required': [('applied_on', '=', '0_product_variant')]}"/>
                <field name="uom_id" groups="uom.group_uom" optional="show"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', asp_allowed_uom_ids)]"
                       attrs="{'readonly': [('asp_target', '=', '0_packaging')]}"/>
                <field name="packaging_id" groups="product.group_stock_packaging" optional="show"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', asp_allowed_packaging_ids)]"
                       attrs="{'readonly': [('asp_target', '=', '1_uom')]}"/>
                <field name="min_quantity"/>
                <field name="compute_price" groups="product.group_sale_pricelist"/>
                <field name="fixed_price" widget="monetary" options="{'field_digits': True}"
                       attrs="{'invisible': [('compute_price', '!=', 'fixed')]}"/>
                <field name="percent_price" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'percentage')]}"/>
                <field name="base" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="base_pricelist_id" groups="product.group_sale_pricelist" optional="hide"
                       options="{'no_create': True}"
                       attrs="{'invisible': ['|', ('compute_price', '!=', 'formula'), ('base', '!=', 'pricelist')],
                               'required': [('compute_price', '=', 'formula'), ('base', '=', 'pricelist')]}"/>
                <field name="price_discount" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price_round" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price_surcharge" string="Extra Fee" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price_surcharge_percent" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price_surcharge_percent_base" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': ['|', ('compute_price', '!=', 'formula'), ('price_surcharge_percent', '=', 0)]}"/>
                <field name="price_min_margin" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price_max_margin" groups="product.group_sale_pricelist" optional="hide"
                       attrs="{'invisible': [('compute_price', '!=', 'formula')]}"/>
                <field name="price" string="Rule" groups="product.group_sale_pricelist" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="asp_pricelist_item_action" model="ir.actions.act_window">
        <field name="name">Pricelist Rules</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="asp_pricelist_item_tree_view_bulk"/>
        <field name="search_view_id" ref="product.product_pricelist_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a pricelist rule</p>
            <p>
                Review and edit the rules of all your pricelists in one place, or load them in bulk
                with the Excel templates available in Favorites &gt; Import records.
            </p>
        </field>
    </record>

    <menuitem id="asp_menu_pricelist_items"
              name="Pricelist Rules"
              parent="sale.product_menu_catalog"
              action="asp_pricelist_item_action"
              groups="product.group_product_pricelist"
              sequence="31"/>

</odoo>
