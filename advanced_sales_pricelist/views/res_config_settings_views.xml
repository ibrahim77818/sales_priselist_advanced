<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_asp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pricelist_configuration']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="asp_convert_qty_on_uom_change"
                     groups="uom.group_uom">
                    <div class="o_setting_left_pane">
                        <field name="asp_convert_qty_on_uom_change"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="asp_convert_qty_on_uom_change"/>
                        <div class="text-muted">
                            Convert the line quantity when its unit of measure changes (24 Units become 2 Dozens)
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="asp_round_qty_to_packaging"
                     groups="product.group_stock_packaging">
                    <div class="o_setting_left_pane">
                        <field name="asp_round_qty_to_packaging"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="asp_round_qty_to_packaging"/>
                        <div class="text-muted">
                            Round the line quantity up to whole packages when a packaging is selected
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
