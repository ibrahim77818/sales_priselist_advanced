<?xml version="1.0" encoding="UTF-8"?>
<!--
    Odoo 16 shows every import template as "Download Template" and ignores the
    label returned by get_import_templates(). Pricelists offer three templates
    (Odoo's + the two of this module), so show each template's own label.
    ImportView.side_panel is a legacy template: extended with t-extend.
-->
<templates xml:space="preserve">
    <t t-extend="ImportView.side_panel">
        <t t-jquery="a[t-att-href] > span" t-operation="replace">
            <span t-if="template.label" t-esc="template.label"/>
            <span t-else="">Download Template</span>
        </t>
    </t>
</templates>
