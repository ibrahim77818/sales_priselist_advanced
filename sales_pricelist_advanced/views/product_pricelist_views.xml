<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rule list of the pricelist form: show the unit / packaging each rule is for. -->
    <record id="product_pricelist_view_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.form.asp</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/list/field[@name='min_quantity']" position="after">
                <field name="uom_id" groups="uom.group_uom" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
