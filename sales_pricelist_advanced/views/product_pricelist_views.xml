<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rule list of the pricelist form: show the unit / packaging each rule is for. -->
    <record id="product_pricelist_view_inherit_asp" model="ir.ui.view">
        <field name="name">product.pricelist.form.asp</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <!-- Core lists the rule unit (hidden by default, not on category rules) -->
            <xpath expr="//field[@name='item_ids']/list/field[@name='uom_id']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

</odoo>
