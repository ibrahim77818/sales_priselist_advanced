"توجد عدة تعبئات باسم \"%(packaging)s\" للمنتج \"%(product)s\" (واحدة لكل "
"متغير): حدّد متغير المنتج في القاعدة."

#. module: sales_pricelist_advanced
#: model:ir.model.fields,field_description:sales_pricelist_advanced.field_product_pricelist_item__asp_target
#: model_terms:ir.ui.view,arch_db:sales_pricelist_advanced.product_pricelist_item_view_search_inherit_asp
