"%(qty)s %(old_uom)s converted to %(new_qty)s %(new_uom)s (rounded to the "
"precision of the unit of measure)."
msgstr ""
"تم تحويل %(qty)s %(old_uom)s إلى %(new_qty)s %(new_uom)s (مع التقريب حسب دقة"
" وحدة القياس)."

