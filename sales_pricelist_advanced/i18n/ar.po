msgstr ""
"التعبئة \"%s\" غير مرتبطة بأي منتج ولا يمكن استخدامها في قاعدة قائمة أسعار."

#. module: sales_pricelist_advanced
#. odoo-python
#: code:addons/sales_pricelist_advanced/models/product_pricelist_item.py:0
#, python-format
